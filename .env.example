# Pulse — Operations Monitoring Pipeline Environment Variables
# Copy to .env for local development

# Database connection URL (Vercel Postgres, Neon, or standard PostgreSQL)
POSTGRES_URL=postgres://pulse_user:pulse_password@localhost:5432/pulse_db

# Slack Incoming Webhook URL for real-time channel paging
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Secret key to secure GET /api/cron endpoint (generate with `openssl rand -hex 32`)
CRON_SECRET=pulse_cron_secret_key_change_in_production

# Optional Gemini API key for automated AI Incident Root-Cause Analysis in Slack alerts
GEMINI_API_KEY=

# LLM spend threshold budget per month in USD
LLM_MONTHLY_BUDGET_USD=600

# Monitored external and internal HTTP APIs (JSON array)
MONITORED_SERVICES=[{"name":"orders-api","url":"https://httpbin.org/status/200","expectedStatus":200,"timeoutMs":5000},{"name":"agent-dispatch-service","url":"https://httpbin.org/status/200","expectedStatus":200,"timeoutMs":5000}]

# Alert cooldown period in minutes before re-alerting for the same service failure
ALERT_COOLDOWN_MINUTES=15

# Public Dashboard base URL for links in Slack alerts
DASHBOARD_URL=http://localhost:3000
